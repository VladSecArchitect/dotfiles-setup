[core]
    # editor: no hardcode — git uses $VISUAL/$EDITOR (set per-OS in ~/.exports: subl on macOS, nano elsewhere)
    excludesfile = ~/.gitignore
    autocrlf = input
    # pager: delta if installed (brew/apt install git-delta), else plain less — portable
    pager = "command -v delta >/dev/null 2>&1 && delta || less -FRX"

[interactive]
    diffFilter = "command -v delta >/dev/null 2>&1 && delta --color-only || cat"

[delta]
    navigate = true
    line-numbers = true
    side-by-side = true

[color]
    ui = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[credential]
    # macOS → Keychain; elsewhere → in-memory cache (no plaintext on disk). Portable.
    helper = "!f() { case \"$(uname -s)\" in Darwin) git-credential-osxkeychain \"$@\" ;; *) git-credential-cache --timeout=3600 \"$@\" ;; esac; }; f"

[status]
    showUntrackedFiles = all

[help]
    autocorrect = 1

[pager]
    difftool = true

[merge]
    # Include summaries of merged commits in newly created merge commit messages
    log = true
    tool = opendiff
    conflictStyle = zdiff3

[diff]
    tool = opendiff
    algorithm = histogram
    colorMoved = default

[alias]
    # View the SHA, description, and history graph of the latest 20 commits
    l = log --pretty=oneline -n 20 --graph
    # View the current working tree status using the short format
    s = status
    # Diff
    d = diff --patch-with-stat
    # Pull in remote changes for the current repository and all its submodules
    p = !"git pull; git submodule foreach git pull origin main"
    # Commit all changes and add message inline
    ca = !git add -A && git commit -avm
    # Commit changes, add any necessary files, and add message in editor
    c = commit -a
    # Switch to a branch, creating it if necessary
    go = checkout -B
    # Show verbose output about tags, branches or remotes
    tags = tag -l
    branches = branch -a
    rv = remote -v
    # Credit an author on the latest commit
    credit = "!f() { git commit --amend --author \"$1 <$2>\" -C HEAD; }; f"
    # Get a list of files from the last commit(s)
    last-commit = diff --name-only HEAD~1 HEAD
    # Grab the commits in the last X days and pretty print the files
    time = "!f() { git log --pretty=format: --name-only --since=\"$1 days ago\"; }; f"
    # Find tags containing commit
    find-tags = "!f() { git describe --always --contains $1; }; f"
    # Find commits by source code
    find-commits = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short -S$1; }; f"
    # Find commits by commit message
    find-messages = "!f() { git log --pretty=format:'%C(yellow)%h  %Cblue%ad  %Creset%s%Cgreen  [%cn] %Cred%d' --decorate --date=short --grep=$1; }; f"
    # Undo a `git push`
    undopush = push -f origin HEAD^:main
    # Reset the current edited files back to the last commit
    rh = reset --hard
    # Pull everything
    pa = pull --all
    # Push everything to a shared repo
    psa = push shared --all

# URL shorthands — always use SSH (git:// is dead on GitHub).
# insteadOf covers both fetch and push, and rewrites any stray git:// URL to SSH.
[url "git@github.com:"]
    insteadOf = "gh:"
    insteadOf = "github:"
    insteadOf = "git://github.com/"
[url "git@gist.github.com:"]
    insteadOf = "gst:"
    insteadOf = "gist:"
    insteadOf = "git://gist.github.com/"
[push]
    default = simple
    autoSetupRemote = true

[pull]
    ff = only

[init]
    defaultBranch = main

[fetch]
    prune = true
    pruneTags = true

[rerere]
    enabled = true
